<?xml version="1.0" encoding="utf-8"?>
<!--
  AMYAL-BRANDING-001 (+ AMYAL-SECURITY-002 in v0.7-C)

  بسبب: usesCleartextTraffic="false" في AndroidManifest.

  هذا الملف هو مكان الاستثناءات (للـ development فقط).
  في production: لا cleartext أبداً.

  لو احتاج المطور اختبار محلي مع 192.168.x.x أو 10.0.x.x HTTP،
  أضف الـ domain هنا فقط للـ debug builds.
-->
<network-security-config>
    <!-- Defaults: HTTPS فقط -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!--
        AMIAL-PILOT-HTTP-001 — استثناء http مؤقّت لخادم التجربة فقط
        (Contabo + Coolify عبر sslip.io بلا شهادة SSL بعد).
        ⚠️ للتجربة فقط — يجب حذفه والانتقال إلى دومين + https قبل الإطلاق/عرض البنك.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">g14f0wej37nlkvqyb1ugm11w.169.58.24.224.sslip.io</domain>
    </domain-config>
</network-security-config>
