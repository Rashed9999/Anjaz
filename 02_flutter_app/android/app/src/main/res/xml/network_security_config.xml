<?xml version="1.0" encoding="utf-8"?>
<!--
  AMIAL-BRANDING-001 (+ AMIAL-SECURITY-002 in v0.7-C)

  بسبب: usesCleartextTraffic="false" في AndroidManifest.

  هذا الملف هو مكان الاستثناءات (للـ development فقط).
  في production: لا cleartext أبداً.

  لو احتاج المطور اختبار محلي مع 192.168.x.x أو 10.0.x.x HTTP،
  أضف الـ domain هنا فقط للـ debug builds.
-->
<network-security-config>
    <!--
        P0-HTTPS-ONLY — النسخة الحالية تتصل افتراضياً بـ https://amialpay.com.
        لا يوجد استثناء HTTP في main/release؛ أي اختبار محلي غير مشفّر يجب
        أن يُعزل لاحقاً في debug manifest/config ولا يُورَّث إلى APK الإنتاج.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
