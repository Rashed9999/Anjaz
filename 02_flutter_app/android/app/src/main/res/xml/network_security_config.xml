<?xml version="1.0" encoding="utf-8"?>
<!--
  AMYAL-BRANDING-001 (+ AMYAL-SECURITY-002 in v0.7-C)

  بسبب: usesCleartextTraffic="false" في AndroidManifest.

  هذا الملف هو مكان الاستثناءات (للـ development فقط).
  في production: لا cleartext أبداً.

  لو احتاج المطور اختبار محلي مع 192.168.x.x أو 10.0.x.x HTTP،
  أضف الـ domain هنا فقط للـ debug builds.
-->
<network-security-config>
    <!-- Defaults: HTTPS فقط -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!--
        Development override — للـ debug build فقط.
        لإضافة domain محلي، fork هذا الملف داخل debug variant:
        android/app/src/debug/res/xml/network_security_config.xml
    -->
</network-security-config>
