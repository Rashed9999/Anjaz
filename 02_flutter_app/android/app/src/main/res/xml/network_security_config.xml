<?xml version="1.0" encoding="utf-8"?>
<!--
  AMIAL-BRANDING-001 (+ AMIAL-SECURITY-002 in v0.7-C)

  بسبب: usesCleartextTraffic="false" في AndroidManifest.

  هذا الملف هو مكان الاستثناءات (للـ development فقط).
  في production: لا cleartext أبداً.

  لو احتاج المطور اختبار محلي مع 192.168.x.x أو 10.0.x.x HTTP،
  أضف الـ domain هنا فقط للـ debug builds.
-->
<network-security-config>
    <!--
        AMIAL-PILOT-HTTP-001 — وضع التجربة: السماح بـ http (cleartext) بالكامل.
        سبب: خادم Contabo/Coolify عبر sslip.io بلا شهادة SSL بعد، وإعداد
        النطاق المحدّد لم يُطبَّق على بعض الأجهزة — فنسمح مؤقّتاً بالكامل ليعمل
        الاختبار بضمان.
        ⚠️⚠️ للتجربة فقط — قبل الإطلاق/عرض البنك: انتقل إلى دومين + https،
        أعِد base-config إلى cleartextTrafficPermitted="false"،
        وأعِد usesCleartextTraffic="false" في AndroidManifest.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
