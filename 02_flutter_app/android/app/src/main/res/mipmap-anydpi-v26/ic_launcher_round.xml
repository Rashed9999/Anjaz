<?xml version="1.0" encoding="utf-8"?>
<!--
  AMIAL-ICON-002 — المستديرة تطابق المربّعة، ولا تعيش وحدها.

  كان هذا الملفّ مكتوباً بيدٍ ويشير إلى @mipmap/ic_launcher_foreground،
  بينما ic_launcher.xml يولّده flutter_launcher_icons ويشير إلى
  @drawable/ic_launcher_foreground. فلمّا جُدّد الشعار تغيّرت المربّعة
  وحدها، وبقيت المستديرة على الشعار القديم — وهي ما يعرضه معظم مشغّلات
  أندرويد. أيقونتان لعلامةٍ واحدة، بلا خطأ في أيّ بناء.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@color/ic_launcher_background"/>
  <foreground>
      <inset
          android:drawable="@drawable/ic_launcher_foreground"
          android:inset="16%" />
  </foreground>
</adaptive-icon>
