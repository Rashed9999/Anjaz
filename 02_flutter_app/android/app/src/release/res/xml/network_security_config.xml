<?xml version="1.0" encoding="utf-8"?>
<!--
  AMIAL-DOMAIN-001 — ضبطُ شبكة نسخة الإصدار (release).

  ══════════════════════════════════════════════════════════════════════
  **هذا الملفّ يحلّ محلّ نظيره في `main` عند بناء الإصدار وحده.**

  ولماذا ملفّان لا رايةٌ تُبدَّل؟ لأنّ الراية تُنسى.

  في `main` نسخةٌ تسمح بالاتّصال غير المشفَّر — وهي ضروريّة اليوم: الخادم
  يعمل على عنوانٍ رقميّ بلا شهادة، وبلا هذا السماح لا يعمل التطبيق أصلاً.
  ومكتوبٌ فيها منذ أشهر «⚠️ قبل الإطلاق أعِدها إلى false» — ولم تُعَد،
  لأنّ التحذيرات المكتوبة لا تُنفّذ نفسها.

  فبدل أن يتذكّر إنسانٌ سطراً في ملفّ XML لحظةَ الإطلاق، **يفرضه نظام
  البناء**: نسخةُ الإصدار لا تحمل السماح أصلاً، ونسخةُ التطوير تحمله.
  فمن بنى للإصدار أغلق الباب وإن لم يعرف أنّه مفتوح.

  ══════════════════════════════════════════════════════════════════════
  **وهذا يعني أنّ نسخة الإصدار لن تعمل حتى يعمل النطاق بـHTTPS.**

  وهو المقصود: نسخةُ إصدارٍ تمرّ كلماتُ سرّ عملائها نصّاً صريحاً أسوأ من
  نسخةٍ لا تُبنى.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
