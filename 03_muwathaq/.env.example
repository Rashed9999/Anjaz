APP_ENV=production

# قاعدة بيانات مستقلة عن أميال باي، تنشأ كمورد MySQL داخل Coolify.
DB_HOST=
DB_PORT=3306
DB_DATABASE=muwathaq
DB_USERNAME=muwathaq
DB_PASSWORD=

# 32 bytes base64. أنشئه مرة: openssl rand -base64 32
MUWATHAQ_DATA_KEY=

# من أميال باي إلى موثّق، ويجب أن يطابق MUWATHAQ_BRIDGE_SECRET في أميال باي.
MUWATHAQ_BRIDGE_SECRET=

# من موثّق إلى أميال باي، ويجب أن يطابق MUWATHAQ_DECISION_SECRET في أميال باي.
MUWATHAQ_DECISION_SECRET=
AMIAL_CORE_BASE_URL=https://amialpay.com

# حساب مراجع واحد كبداية. خزّن hash فقط، لا كلمة المرور الخام.
MUWATHAQ_REVIEWER_EMAIL=
MUWATHAQ_REVIEWER_PASSWORD_HASH=
