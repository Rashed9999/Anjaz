APP_ENV=production

# الأسهل في Coolify: انسخ MySQL URL (internal) كاملًا إلى DATABASE_URL.
# عند استخدامه لا تحتاج إلى DB_HOST/DB_PORT/DB_DATABASE/DB_USERNAME/DB_PASSWORD.
DATABASE_URL=

# بديل يدوي إذا لم يتوفر رابط MySQL الداخلي:
DB_HOST=
DB_PORT=3306
DB_DATABASE=muwathaq
DB_USERNAME=muwathaq
DB_PASSWORD=

# 32 bytes base64. أنشئه مرة: openssl rand -base64 32
MUWATHAQ_DATA_KEY=

# سر نقل واحد مشترك مع أميال باي. يُشتق منه توقيع مختلف لكل اتجاه.
MUWATHAQ_TRANSPORT_SECRET=

# مفتاحا التدوير الاختياريان أدناه يتقدمان على سر النقل الموحّد عند ضبطهما.
MUWATHAQ_BRIDGE_SECRET=
MUWATHAQ_DECISION_SECRET=
AMIAL_CORE_BASE_URL=https://amialpay.com

# أنشئ حساب المراجع من داخل حاوية موثّق بعد أول تشغيل:
# php /var/www/bin/setup-reviewer.php
# لا تخزّن كلمة مرور المراجع في متغيرات البيئة.
