# ══════════════════════════════════════════════════════════
# أميال باي — قالب بيئة الإنتاج
#
# ⚠️ انسخ هذا الملف إلى .env.production واملأ القيم الحقيقية.
# ⚠️ .env.production مُستثنى من Git تلقائياً (راجع .gitignore).
# ⚠️ لا تُشارك القيم المملوءة مع أحد خارج فريق التشغيل.
# ══════════════════════════════════════════════════════════

APP_NAME="أميال باي"
APP_ENV=production
APP_DEBUG=false
# AMIAL-DEVOPS-004 — يرفض entrypoint.prod.sh العمل لو APP_DEBUG=true

# وَلِّد مرّة واحدة بأمان: php artisan key:generate --show
# ثمّ لا تُغيِّره أبداً (تغييره يُفقِد فكّ تشفير البيانات المشفَّرة الحالية)
APP_KEY=

APP_URL=https://your-domain.com
APP_PUBLIC_URL=https://your-domain.com

# ── قاعدة البيانات ─────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=amial-mysql
DB_PORT=3306
DB_DATABASE=amial_pay_production
DB_USERNAME=amial_prod_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_DIFFERENT_STRONG_PASSWORD

# ── Redis (cache/queue/session — موصى به للإنتاج) ─────────
REDIS_HOST=amial-redis
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD
REDIS_PORT=6379
REDIS_CLIENT=phpredis

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
# AMIAL-DEVOPS-005 — يجب أن يكون true دائماً خلف HTTPS في الإنتاج
SESSION_SECURE_COOKIE=true

# ── السجلّات (rotation يومي — لا ملف واحد ينمو للأبد) ─────
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# ── WhatsApp Bot (Meta Cloud API) ─────────────────────────
META_WA_VERIFY_TOKEN=CHANGE_ME_RANDOM_STRING
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_WA_APP_SECRET=

# ── SMS/OTP ────────────────────────────────────────────────
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# ── البريد ─────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@your-domain.com
MAIL_FROM_NAME="أميال باي"

# ── الإعدادات المالية ──────────────────────────────────────
AMIAL_SAFE_PAYMENT_FEE_PERCENT=1
AMIAL_SEND_MONEY_FEE_PERCENT=0.5
APP_SUPPORT_PHONE=

# ── مراقبة الأخطاء (اختياري — Sentry/Bugsnag إلخ) ─────────
# SENTRY_LARAVEL_DSN=
