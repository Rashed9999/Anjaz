# أميال باي — قالب الديمو المحلّي
# انسخه مرة واحدة: cp .env.demo.example .env.demo
# لا ترفع .env.demo إلى Git. أضف أسرار ngrok/Meta محلياً فقط عند الحاجة.

APP_NAME="Amial Pay Demo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PUBLIC_URL=http://localhost:8000

DB_CONNECTION=mysql
DB_HOST=amial-mysql
DB_PORT=3306
DB_DATABASE=amial_pay
DB_USERNAME=amial_user
DB_PASSWORD=demo_local_only_pw

CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

LOG_CHANNEL=stack
LOG_LEVEL=debug

# WhatsApp / Meta — اتركها فارغة ما لم تُفعّل التكامل محلياً.
META_WA_VERIFY_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_WA_APP_SECRET=

# ngrok اختياري لعرض الـ webhook من الشبكة العامة.
NGROK_AUTHTOKEN=

# Twilio اختياري للديمو فقط.
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.test"
MAIL_FROM_NAME="${APP_NAME}"

PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=

# رسوم الديمو: يبقيها التطبيق محلية وغير إنتاجية.
AMIAL_SAFE_PAYMENT_FEE_PERCENT=0
AMIAL_SEND_MONEY_FEE_PERCENT=0
APP_SUPPORT_PHONE=
