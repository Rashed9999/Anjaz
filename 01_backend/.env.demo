# ══════════════════════════════════════════════════════════════════
# ⚠️  ملف تجريبي محلّي فقط (Local Docker Demo) — ليس للإنتاج إطلاقاً.
# كل القيم أدناه محلّية-فقط لحاوية docker-compose.yml التجريبية.
# الإنتاج يقرأ من .env.production (غير متتبَّع) عبر docker-compose.prod.yml.
# لا تضع أي سرّ حقيقي هنا.
# ══════════════════════════════════════════════════════════════════
APP_NAME="أميال باي"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PUBLIC_URL=http://localhost:8000

# قاعدة البيانات — تُملأ تلقائياً من docker-compose
DB_CONNECTION=mysql
DB_HOST=amial-mysql
DB_PORT=3306
DB_DATABASE=amial_pay
DB_USERNAME=amial_user
DB_PASSWORD=demo_local_only_pw

# الكاش والقوائم (database — لا يحتاج Redis)
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

# الـ Log
LOG_CHANNEL=single
LOG_LEVEL=debug

# ══════════════════════════════════════════════════════
# WhatsApp Bot — أضف هذه القيم بعد حصولك على ngrok URL
# راجع خطوة 3 في demo.sh
# ══════════════════════════════════════════════════════
META_WA_VERIFY_TOKEN=demo_verify_token_change_in_meta_dashboard
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_WA_APP_SECRET=

# ngrok token (من: https://dashboard.ngrok.com/get-started/your-authtoken)
NGROK_AUTHTOKEN=

# SMS (اختياري في الديمو — OTP سيُسجَّل في Log)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# البريد (اختياري)
MAIL_MAILER=log
MAIL_FROM_ADDRESS=demo@amyal.pay
MAIL_FROM_NAME="أميال باي"

# مفاتيح تشفير Passport (تُنشأ تلقائياً)
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=

# الإعدادات المالية
AMIAL_SAFE_PAYMENT_FEE_PERCENT=1
AMIAL_SEND_MONEY_FEE_PERCENT=0.5
APP_SUPPORT_PHONE=967777000000
