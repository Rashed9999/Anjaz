# ============================================================
# أميال باي — Backend (.env.example)
# انسخه إلى .env ثم عدّل القيم: cp .env.example .env
# ثم: php artisan key:generate
# ============================================================

APP_NAME="Amial Pay"
APP_ENV=local
APP_KEY=

# بوابة موثّق هي نطاق فرعي داخلي للمراجعة، وليست بوابة تسجيل بديلة.
# يرسل أميال باي الطلبات إليها في الخلفية؛ اتركهما فارغين قبل نشرها فتظل
# الطلبات محفوظة بانتظار الربط.
MUWATHAQ_BASE_URL=
# سر نقل واحد مشترك مع موثّق. يشتق النظام مفاتيح مختلفة لكل اتجاه.
MUWATHAQ_TRANSPORT_SECRET=
MUWATHAQ_TIMEOUT_SECONDS=10
# مفتاحا التدوير الاختياريان أدناه يتقدمان على سر النقل الموحّد عند ضبطهما.
MUWATHAQ_BRIDGE_SECRET=
MUWATHAQ_DECISION_SECRET=
MUWATHAQ_ALLOWED_CLOCK_SKEW_SECONDS=300
APP_DEBUG=true
# قاعدة البيانات وعمليات التسوية تحفظ الزمن UTC. العرض المالي للمستخدمين
# مضبوط من AMIAL_DISPLAY_TIMEZONE ولا يعتمد على منطقة جهازهم.
APP_TIMEZONE=UTC
AMIAL_DISPLAY_TIMEZONE=Asia/Riyadh
APP_URL=http://localhost:8000
# فعّله بعد DNS وTLS؛ يظلّ /merchant القديم صالحاً عندما يكون فارغاً.
AMIAL_MERCHANT_HOST=
# لا تشارك كوكي الإدارة/الوكيل/التاجر؛ اترك SESSION_DOMAIN فارغاً.
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

# ----------------------- Database --------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=amial_pay
DB_USERNAME=root
DB_PASSWORD=

# ----------------------- Cache / Queue ---------------------
# الطابور مطلوب للإشعارات async (SendTransactionNotificationJob)
BROADCAST_CONNECTION=log
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

# ----------------------- Redis (اختياري) -------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ----------------------- Mail ------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="verify@amialpay.com"
MAIL_FROM_NAME="${APP_NAME}"

# ----------------------- Email OTP / Resend ----------------
# المرحلة التجريبية: التسجيل والاستعادة بالبريد. لا تحذف إعدادات SMS أدناه؛
# يمكن الرجوع إليها لاحقاً بتغيير القناة فقط.
REGISTRATION_OTP_CHANNEL=email
PASSWORD_RESET_CHANNEL=email
PIN_RECOVERY_CHANNEL=email
OTP_TTL_MINUTES=5
# Only needed to create absent bootstrap accounts. Supply real, distinct
# mailboxes keyed by their canonical phone; ownership remains unverified.
AMIAL_BOOTSTRAP_EMAILS='{}'
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_VERIFICATION_TTL_MINUTES=10
# سر Resend يوضع في بيئة النشر فقط ولا يُرفع إلى GitHub.
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com/emails
# اختياري إلى أن تنشئ Webhook في Resend. يبدأ عادةً بـ whsec_
RESEND_WEBHOOK_SECRET=

# ----------------------- Transaction email receipts --------
# Financial receipts use a dedicated sender identity. The domain must be
# verified at Resend before production delivery.
AMIAL_TRANSACTION_EMAIL_ENABLED=true
AMIAL_TRANSACTION_EMAIL_FROM_ADDRESS="receipts@amialpay.com"
AMIAL_TRANSACTION_EMAIL_FROM_NAME="أميال باي | إيصالات المعاملات"

# اختياريان: القالب يستخدم APP_URL/branding/logo.png و amialpay.com افتراضياً.
# يجب أن يكون رابط الشعار مطلقاً وقابلاً للوصول من خارج الخادم لأن قارئ البريد
# لا يستطيع تحميل asset() النسبي من Laravel.
MAIL_BRAND_LOGO_URL=https://amialpay.com/branding/logo.png
MAIL_WEBSITE_URL=https://amialpay.com

# ----------------------- Filesystem ------------------------
FILESYSTEM_DISK=public
# disk خاص لـ KYC/Receipts (يجب تعريفه في config/filesystems.php — انظر docs/PATCH_Helpers.md)
AMIAL_RECEIPTS_DISK=private
AMIAL_RECEIPTS_RETENTION_DAYS=2555

# ----------------------- رمز التحقّق التجريبي ----------------
# هذا قالب عام آمن للنشر: لا تضع أي رمز ثابت أو رقم اختبار في المستودع.
# الإعدادات التجريبية، إن لزم الأمر، تُحفظ حصراً في متغيرات Coolify الخاصة
# ببيئة التجربة وتُفعّل بقرار صريح عبر AMIAL_ALLOW_DEMO_OTP=true.
# للإنتاج الحقيقي: اربط مزود SMS/WhatsApp، وأبقِ القيم الأربع التالية فارغة/
# معطّلة. مدخل الحاوية يرفض الإقلاع إذا فعّلت رمزاً تجريبياً بلا تصريح صريح.
AMIAL_PILOT_CUSTOMER_PHONE_OTP_ENABLED=false
AMIAL_PILOT_CUSTOMER_PHONE_OTP=
AMIAL_DEMO_OTP=
AMIAL_DEMO_PHONES=
AMIAL_ALLOW_DEMO_OTP=false

# ----------------------- Firebase (FCM) --------------------
# محتوى ملف service-account (JSON) لإشعارات Firebase
PUSH_NOTIFICATION_SERVICE_FILE_CONTENT=

# ============================================================
#  أميال باي — مفاتيح خاصّة (config/amial.php)
# ============================================================
# مفاتيح تشفير PII (إلزاميّة في الإنتاج — ولّدها بـ 32 byte عشوائي)
AMIAL_PII_ENCRYPTION_KEY=
AMIAL_PII_BLIND_INDEX_KEY=

# ---------------- هويّة أجهزة نقاط البيع (POS) ----------------
# AMIAL-POS-DEVICES-001 — سرٌّ **مستقلٌّ عن APP_KEY** تُجزَّأ به بصماتُ
# الأجهزة. ولا يُشتقّ من APP_KEY: ذاك يُدوَّر لأسبابٍ لا علاقةَ لها
# بالأجهزة، وتدويرُه حينئذٍ يمحو هويّةَ كلّ جهازٍ مسجَّل دفعةً واحدة
# فتُقفل المتاجرُ صباحاً بلا سبب. ولّده بـ 32 byte عشوائيّ.
# **وغيابُه يُسقط تسجيلَ الأجهزة برسالةٍ صريحة** — ولا يُشتقّ صامتاً.
AMIAL_DEVICE_HASH_KEY=
AMIAL_DEVICE_HASH_KEY_VERSION=1
# للتدوير بلا فقدِ هويّة: يبقى القديمُ هنا حتّى تُرحَّل الأجهزةُ كلُّها،
# ثمّ يُحذف. الصيغة: "1:oldkey,2:olderkey"
AMIAL_DEVICE_HASH_KEYS_PREVIOUS=

# Safe Pay (الضمان/escrow)
AMIAL_SAFE_PAYMENT_FEE_PERCENT=1.0
AMIAL_SAFE_PAYMENT_MAX_AMOUNT=1000000
AMIAL_SAFE_PAYMENT_BUYER_DAYS=7
AMIAL_SAFE_PAYMENT_SELLER_HOURS=48

# التبرّعات
AMIAL_DONATIONS_FEE_PERCENT=0
AMIAL_DONATIONS_MIN_AMOUNT=1
AMIAL_DONATIONS_MAX_AMOUNT=1000000

# الصناديق العائلية
AMIAL_FUND_MAX_MEMBERS=20
AMIAL_FUND_MAX_PER_USER=5

# دفع الفواتير
AMIAL_BILL_RECONCILE_HOURS=24
AMIAL_BILL_MAX_RECONCILE=500

# ----------------------- Reporting / Support SLA -----------
# AMIAL-REPORTING-P2-001 — لا توجد قيم افتراضية متخيّلة.
# اعتمد الإدارة أهداف الحل بالدقائق لكل أولوية ثم ضعها في بيئة الإنتاج.
# يبقى تقرير SLA «جزئياً» حتى تكون القيم الأربع موجبة ومضبوطة.
AMIAL_SUPPORT_SLA_URGENT_MINUTES=
AMIAL_SUPPORT_SLA_HIGH_MINUTES=
AMIAL_SUPPORT_SLA_NORMAL_MINUTES=
AMIAL_SUPPORT_SLA_LOW_MINUTES=

# ----------------------- SMS / OTP -------------------------
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
VONAGE_KEY=
VONAGE_SECRET=

# ----------------------- KYC AI / OpenRouter ---------------
# بعد مراجعة معالجة البيانات، أضف المفتاح في Coolify فقط وسيصبح الفحص اليدوي جاهزاً.
# لا يرسل المستندات بمجرد إضافة المفتاح؛ الموظف المخوّل يطلب التحليل من الشاشة.
# أوقف الخدمة في الطوارئ بوضع AMIAL_KYC_AI_ENABLED=false.
# يطلب النظام مزوداً يتوافق مع ZDR ومنع جمع البيانات وإلا يرفض الطلب.
OPENROUTER_API_KEY=
AMIAL_KYC_AI_ENABLED=true
AMIAL_KYC_AI_MODEL=google/gemini-3.1-flash-lite
# إرسال الصور الأصلية خيار مستقل؛ البداية تحليل OCR والبيانات فقط.
AMIAL_KYC_AI_SEND_IMAGES=false
AMIAL_KYC_AI_DAILY_LIMIT=30

# ----------------------- Logging ---------------------------
LOG_CHANNEL=stack
LOG_LEVEL=debug

# ============================================================
# AMIAL-WA-001 — WhatsApp Bot
# ============================================================
# Verify token (أنت تختاره — Meta يطلبه مرّة واحدة عند الإعداد)
META_WA_VERIFY_TOKEN=

# App Secret (من Meta Developer Portal → App Settings → Basic)
META_WA_APP_SECRET=

# دعم واتساب (للردّ من البوت)
APP_SUPPORT_PHONE=967777000000

# AMIAL-RECON-NIGHTLY-001 — المصالحة الليليّة (٢:٠٠ صباحاً)
# أرقامٌ يصلها الإنذار عند وجود فرق (واتساب، مفصولةً بفاصلة)
AMIAL_RECON_ALERT_TO=
# فرقٌ دونه لا يُنذَر — تقريبُ الكسور لا يستحقّ إيقاظك
AMIAL_RECON_THRESHOLD=0.01
