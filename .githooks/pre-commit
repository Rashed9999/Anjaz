#!/usr/bin/env bash
#
# AMIAL-GUARD-COMMIT-001 — القاعدة الأولى تُفرَض بنيةً لا بتذكُّر.
#
# ══════════════════════════════════════════════════════════════════════
# **الثمن الذي دُفع:** كُتبت القاعدة الأولى («لا يُلتزَم قبل صفر فشل»)،
# ثمّ كُتب أمرٌ هكذا:
#
#     bash scripts/verify.sh --fast | tail -6 && git commit …
#
# ورمزُ خروج الأنبوب هو رمزُ **آخرِ** أمرٍ فيه — `tail` — وهو ينجح دائماً.
# فابتلع الأنبوبُ الفشل، ومرّ `&&`، ودُفع التزامٌ والفحصُ يقول «فشل ١٦».
#
# والقاعدةُ لم تكن خطأً — كان الاعتمادُ عليها في رأسي هو الخطأ.
# **واختياريٌّ عندي = غيرُ موجود** (القاعدة الحادية عشرة، على نفسي).
#
# فصار المنعُ في git لا في انتباهي.
#
# التخطّي عند الضرورة (ويُعلَن في رسالة الالتزام):  AMIAL_SKIP_VERIFY=1
# ══════════════════════════════════════════════════════════════════════

set -euo pipefail

BACKEND="$(git rev-parse --show-toplevel)/01_backend"
[ -f "$BACKEND/scripts/verify.sh" ] || exit 0

if [ "${AMIAL_SKIP_VERIFY:-0}" = "1" ]; then
    echo "⚠️  تُخطّي الفحص بطلبٍ صريح (AMIAL_SKIP_VERIFY=1)"
    exit 0
fi

# لا شيء من الخادم تغيّر ⇒ لا داعي للفحص الكامل.
if git diff --cached --name-only | grep -qv '^01_backend/'; then
    if ! git diff --cached --name-only | grep -q '^01_backend/'; then
        exit 0
    fi
fi

echo "▶ القاعدة الأولى: يُفحص قبل الالتزام…"

# **قاعدةُ البيانات تسقط في هذه البيئة كثيراً**، وسقوطها يُنتج ١٦ فشلاً
# كاذباً كلُّها «انهيار 500». فتُنعش أوّلاً كي لا يُقرأ عطلُ بيئةٍ عطلَ
# شيفرة — ولا العكس: عطلُ شيفرةٍ يُعذَر بأنّه بيئة.
HOOKS="$(git rev-parse --show-toplevel)/.claude/hooks/session-start.sh"
if [ -x "$HOOKS" ] && ! mysqladmin ping >/dev/null 2>&1; then
    echo "  ↻ قاعدةُ البيانات ساقطة — تُنعَش…"
    CLAUDE_CODE_REMOTE=true bash "$HOOKS" >/dev/null 2>&1 || true
fi

# **بلا أنبوب.** الأنبوبُ هو ما ابتلع الفشل أوّل مرّة.
if ! ( cd "$BACKEND" && bash scripts/verify.sh ); then
    echo
    echo "🛑 الفحصُ فشل — لا التزام."
    echo "   أصلِح، أو AMIAL_SKIP_VERIFY=1 git commit … وقُل لماذا في الرسالة."
    exit 1
fi

echo "✓ الفحصُ نظيف — يُسمح بالالتزام."
